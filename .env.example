# GEMINI_API_KEY: Optional Gemini API key injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: Optional MongoDB connection string. When omitted, Melody uses local atomic persistence in data/melody-db.json.
MONGODB_URI=""

# JWT_SECRET: Secret key used to sign authentication tokens.
JWT_SECRET="melody-dev-secret-change-in-production"

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for Google Sign-In.
VITE_GOOGLE_CLIENT_ID=""
